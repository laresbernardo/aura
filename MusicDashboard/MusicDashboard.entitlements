<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandboxing disabled: Aura is a local personal tool that reads the Music
         library XML file directly from disk. App Store submission would require
         re-enabling this and using the MediaLibrary framework instead. -->

    <!-- Allows JXA automation scripting of the Music app (fallback path) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
